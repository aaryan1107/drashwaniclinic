# Copy to .env and fill with your real values. Do NOT commit .env.
# Frontend (Vite) env — must be prefixed with VITE_ to be exposed to the app.

# Supabase project
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_anon_key

# Razorpay (online consultation fee is locked to Rs 700)
VITE_RAZORPAY_KEY_ID=rzp_live_or_test_key
VITE_RAZORPAY_API_BASE=https://YOUR-PROJECT-ref.supabase.co/functions/v1
VITE_RAZORPAY_PAYMENT_LINK=https://razorpay.me/@your-razorpay-handle

# --- Supabase Edge Function secrets (set via `supabase secrets set`, NOT here) ---
# RAZORPAY_KEY_ID=...
# RAZORPAY_KEY_SECRET=...
# PROJECT_URL=...
# SERVICE_ROLE_KEY=...
# OPENAI_API_KEY=...
# OPENAI_MODEL=gpt-4.1-mini

# Printed on every prescription PDF (build-time, not stored in the repo)
# VITE_RX_REGISTRATION=...
# VITE_RX_PHONE=...
